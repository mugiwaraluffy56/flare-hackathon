# Application Settings
APP_NAME=FACE AI Risk Engine
APP_VERSION=2.0.0
DEBUG=false

# Server Settings
HOST=0.0.0.0
PORT=3001
WORKERS=4

# Redis Settings
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
CACHE_TTL=300

# Model Settings
MODEL_PATH=./models
MODEL_VERSION=v1
RETRAIN_THRESHOLD=0.85

# Risk Thresholds
LOW_RISK_THRESHOLD=30
MEDIUM_RISK_THRESHOLD=60
HIGH_RISK_THRESHOLD=85

# Monitoring
ENABLE_METRICS=true
LOG_LEVEL=INFO
